Windows Registry Editor Version 5.00

;paste form clipboard

[HKEY_CLASSES_ROOT\Directory\Background\shell\pasteFromClipboard]
@="Paste from Clipboard"
"Icon"="rcwmimg.dll,-35"

[HKEY_CLASSES_ROOT\Directory\Background\shell\pasteFromClipboard\command]
@="pwsh -NoProfile -ExecutionPolicy Bypass \"C:\\Program Files\\RCWM\\rcp.ps1\" rcopy p \"%V\""
"IsolatedCommand"="pwsh -NoProfile -ExecutionPolicy Bypass \"C:\\Program Files\\RCWM\\rcp.ps1\" rcopy p \"%V\""
; end