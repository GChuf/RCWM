Windows Registry Editor Version 5.00

;move dir

[HKEY_CLASSES_ROOT\Directory\shell\mvdir]
@="Move These Directories"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-3"

[HKEY_CLASSES_ROOT\Directory\shell\mvdir\command]
@="C:\\Program Files (x86)\\RCWM\\rcwm-multiple.exe rmove %V"
"IsolatedCommand"="C:\\Program Files (x86)\\RCWM\\rcwm-multiple.exe rmove %V"

[HKEY_CLASSES_ROOT\Directory\Background\shell\mvdir]
@="Move Directories Here"
"Icon"="rcwmimg.dll,-4"

[HKEY_CLASSES_ROOT\Directory\Background\shell\mvdir\command]
@="pwsh -NoProfile C:\\Program Files (x86)\\RCWM\\rcp.ps1 mv m \"%V\""
"IsolatedCommand"="pwsh -NoProfile C:\\Program Files (x86)\\RCWM\\rcp.ps1 mv m \"%V\""

; end
