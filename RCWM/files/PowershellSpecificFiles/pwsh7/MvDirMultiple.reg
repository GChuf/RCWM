Windows Registry Editor Version 5.00

;move dir

[HKEY_CLASSES_ROOT\*\shell\rcmov]
@="Move items"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-3"

[HKEY_CLASSES_ROOT\*\shell\rcmov\command]
@="C:\\Program Files\\RCWM\\rcwm-multiple.exe rcmov %V"
"IsolatedCommand"="C:\\Program Files\\RCWM\\rcwm-multiple.exe rcmov %V"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rcmov]
@="Move files here"
"Icon"="rcwmimg.dll,-4"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rcmov\command]
@="pwsh -NoProfile \"C:\\Program Files\\RCWM\\rcp.ps1\" rcmov m \"%V\""
"IsolatedCommand"="pwsh -NoProfile \"C:\\Program Files\\RCWM\\rcp.ps1\" rcmov m \"%V\""
; end