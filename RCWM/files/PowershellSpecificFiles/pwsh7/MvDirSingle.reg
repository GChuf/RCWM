Windows Registry Editor Version 5.00

;move dir

[HKEY_CLASSES_ROOT\Directory\shell\mvdir]
@="Move files"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-3"

[HKEY_CLASSES_ROOT\Directory\shell\mvdir\command]
@="C:\\Program Files\\RCWM\\rcwm-single.exe rcmov %V"
"IsolatedCommand"="C:\\Program Files\\RCWM\\rcwm-single.exe rcmov %V"

[HKEY_CLASSES_ROOT\*\shell\mvdir]
@="Move files"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-3"

[HKEY_CLASSES_ROOT\*\shell\mvdir\command]
@="C:\\Program Files\\RCWM\\rcwm-single.exe rcmov %V"
"IsolatedCommand"="C:\\Program Files\\RCWM\\rcwm-single.exe rcmov %V"

[HKEY_CLASSES_ROOT\Directory\Background\shell\mvdir]
@="Move files here"
"Icon"="rcwmimg.dll,-4"

[HKEY_CLASSES_ROOT\Directory\Background\shell\mvdir\command]
@="pwsh -NoProfile \"C:\\Program Files\\RCWM\\rcp.ps1\" rcmov s \"%V\""
"IsolatedCommand"="pwsh -NoProfile \"C:\\Program Files\\RCWM\\rcp.ps1\" rcmov s \"%V\""
; end