Windows Registry Editor Version 5.00

;Add "Kill All" command to backgrounds

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\DesktopBackground\Shell\killall]
@="Kill All"
"Icon"="rcwmimg.dll,-27"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\DesktopBackground\Shell\killall\command]
@="pwsh -NoProfile -ExecutionPolicy Bypass \"C:\\Program Files\\RCWM\\killall.ps1\""


[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\killall]
@="Kill All"
"Icon"="rcwmimg.dll,-27"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\killall\command]
@="pwsh -NoProfile -ExecutionPolicy Bypass \"C:\\Program Files\\RCWM\\killall.ps1\""

;done