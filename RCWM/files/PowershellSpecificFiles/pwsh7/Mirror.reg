Windows Registry Editor Version 5.00

;robocopy mirror

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\mirror]
@="Mirror Source Directory"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-20"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\mirror\command]
@="C:\\Program Files\\RCWM\\rcwm-single.exe miror %V"


[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\mirror]
@="Mirror Destination Directory"
"Icon"="rcwmimg.dll,-20"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\mirror\command]
@="pwsh -NoProfile -ExecutionPolicy Bypass \"C:\\Program Files\\RCWM\\rcp.ps1\" miror s \"%V\""
; end
