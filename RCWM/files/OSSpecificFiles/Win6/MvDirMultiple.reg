Windows Registry Editor Version 5.00

;move dir

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\rcmov]
@="Move items"
"NoWorkingDirectory"=""
"MultiSelectModel"="Document"
"Icon"="rcwmimg.dll,-3"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\*\shell\rcmov\command]
@="C:\\Program Files\\RCWM\\rcwm-multiple.exe rcmov %V"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\rcmov]
@="Move items"
"NoWorkingDirectory"=""
"MultiSelectModel"="Document"
"Icon"="rcwmimg.dll,-3"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\rcmov\command]
@="C:\\Program Files\\RCWM\\rcwm-multiple.exe rcmov %V"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\rcmov]
@="Move here"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-4"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\rcmov\command]
@="\"C:\\Program Files\\RCWM\\rcp.cmd\" \"%V\" rcmov m"
; end