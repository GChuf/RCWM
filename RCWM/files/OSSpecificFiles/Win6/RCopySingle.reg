Windows Registry Editor Version 5.00

;robocopy

[HKEY_CLASSES_ROOT\Directory\shell\rcopy]
@="Copy directory"
"NoWorkingDirectory"=""
"MultiSelectModel"="Single"
"Icon"="rcwmimg.dll,-5"

[HKEY_CLASSES_ROOT\Directory\shell\rcopy\command]
@="C:\\Program Files\\RCWM\\rcwm-single.exe rcopy %V"

[HKEY_CLASSES_ROOT\*\shell\rcopy]
@="Copy file"
"NoWorkingDirectory"=""
"MultiSelectModel"="Single"
"Icon"="rcwmimg.dll,-3"

[HKEY_CLASSES_ROOT\*\shell\rcopy\command]
@="C:\\Program Files\\RCWM\\rcwm-single.exe rcopy %V"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rpaste]
@="Paste here"
"Icon"="rcwmimg.dll,-6"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rpaste\command]
@="\"C:\\Program Files\\RCWM\\rcp.cmd\" \"%V\" rcopy s"
; end