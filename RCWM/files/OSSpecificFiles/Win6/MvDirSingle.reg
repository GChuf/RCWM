Windows Registry Editor Version 5.00

;move dir

[HKEY_CLASSES_ROOT\Directory\shell\rcmov]
@="Move directory"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-3"

[HKEY_CLASSES_ROOT\Directory\shell\rcmov\command]
@="C:\\Program Files\\RCWM\\rcwm-single.exe rcmov %V"
"IsolatedCommand"="C:\\Program Files\\RCWM\\rcwm-single.exe rcmov %V"

[HKEY_CLASSES_ROOT\*\shell\rcmov]
@="Move file"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-3"

[HKEY_CLASSES_ROOT\*\shell\rcmov\command]
@="C:\\Program Files\\RCWM\\rcwm-single.exe rcmov %V"
"IsolatedCommand"="C:\\Program Files\\RCWM\\rcwm-single.exe rcmov %V"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rcmov]
@="Move here"
"Icon"="rcwmimg.dll,-4"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rcmov\command]
@="\"C:\\Program Files\\RCWM\\rcp.cmd\" \"%V\" rcmov s"
"IsolatedCommand"="\"C:\\Program Files\\RCWM\\rcp.cmd\" \"%V\" rcmov s"
; end