Windows Registry Editor Version 5.00

;add powershell window to right click menu

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\pwrshell]
@="Open Powershell Window here"
"Icon"="rcwmimg.dll,-10"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\pwrshell\command]
@="C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -noexit -command Set-Location -literalPath '%V'"



[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\pwrshell]
@="Open Powershell Window here"
"Icon"="rcwmimg.dll,-10"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\pwrshell\command]
@="C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -noexit -command Set-Location -literalPath '%V'"



[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Drive\shell\pwrshell]
@="Open Powershell Window here"
"Icon"="rcwmimg.dll,-10"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Drive\shell\pwrshell\command]
@="C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe -noexit -command Set-Location -literalPath '%V'"

;done
