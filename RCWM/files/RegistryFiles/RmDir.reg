Windows Registry Editor Version 5.00

;rmdir

[HKEY_CLASSES_ROOT\Directory\shell\rmdir]
@="Remove Directory"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-2"

[HKEY_CLASSES_ROOT\Directory\shell\rmdir\command]
@="cmd /c powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files\\RCWM\\rmdir.ps1\" \"%V\""
"IsolatedCommand"="cmd /c powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files\\RCWM\\rmdir.ps1\" \"%V\""

;done