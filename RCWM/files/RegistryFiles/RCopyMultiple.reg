Windows Registry Editor Version 5.00

;robocopy

[HKEY_CLASSES_ROOT\Directory\shell\rcopy]
@="RoboCopy Directories"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-5"

[HKEY_CLASSES_ROOT\Directory\shell\rcopy\command]
@="C:\\Program Files (x86)\\RCWM\\rcwm-multiple.exe rcopy %V"
"IsolatedCommand"="C:\\Program Files (x86)\\RCWM\\rcwm-multiple.exe rcopy %V"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rpaste]
@="RoboPaste Directories"
"Icon"="rcwmimg.dll,-6"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rpaste\command]
@="cmd /c powershell Set-ExecutionPolicy Bypass -NoProfile -Command \"& 'C:\\Program Files (x86)\\RCWM\\rcp.ps1' rcopy m '%V'\""
"IsolatedCommand"="cmd /c powershell Set-ExecutionPolicy Bypass -NoProfile -Command \"& 'C:\\Program Files (x86)\\RCWM\\rcp.ps1' rcopy m '%V'\""

; end