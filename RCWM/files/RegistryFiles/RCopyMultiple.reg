Windows Registry Editor Version 5.00

;robocopy

[HKEY_CLASSES_ROOT\*\shell\rcopy]
@="Copy items"
"NoWorkingDirectory"=""
"MultiSelectModel"="Document"
"Icon"="rcwmimg.dll,-5"

[HKEY_CLASSES_ROOT\*\shell\rcopy\command]
@="C:\\Program Files\\RCWM\\rcwm-multiple.exe rcopy %V"

[HKEY_CLASSES_ROOT\Directory\shell\rcopy]
@="Copy items"
"NoWorkingDirectory"=""
"MultiSelectModel"="Document"
"Icon"="rcwmimg.dll,-5"

[HKEY_CLASSES_ROOT\Directory\shell\rcopy\command]
@="C:\\Program Files\\RCWM\\rcwm-multiple.exe rcopy %V"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rpaste]
@="Paste here"
"Icon"="rcwmimg.dll,-6"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rpaste\command]
@="cmd /c powershell -NoProfile -ExecutionPolicy Bypass -File \"C:\\Program Files\\RCWM\\rcp.ps1\" rcopy m \"%V\""
; end