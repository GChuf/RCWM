Windows Registry Editor Version 5.00

;robocopy

[HKEY_CLASSES_ROOT\Directory\shell\rcopys]
@="RoboCopy Structure"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-19"

[HKEY_CLASSES_ROOT\Directory\shell\rcopys\command]
@="C:\\Program Files\\RCWM\\rcwm-single.exe rstrc %V"
"IsolatedCommand"="C:\\Program Files\\RCWM\\rcwm-single.exe rstrc %V"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rpastes]
@="RoboPaste Structure"
"Icon"="rcwmimg.dll,-19"
[HKEY_CLASSES_ROOT\Directory\Background\shell\rpastes\command]
@="\"C:\\Program Files\\RCWM\\RcopyStructure.bat\""
"IsolatedCommand"="\"C:\\Program Files\\RCWM\\RcopyStructure.bat\""

; end