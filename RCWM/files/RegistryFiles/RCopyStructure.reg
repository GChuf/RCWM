Windows Registry Editor Version 5.00

;robocopy

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\rstrc]
@="Copy Structure"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-19"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\shell\rstrc\command]
@="C:\\Program Files\\RCWM\\rcwm-single.exe rstrc %V"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\rstrc]
@="Paste Structure here"
"Icon"="rcwmimg.dll,-19"
[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\rstrc\command]
@="\"C:\\Program Files\\RCWM\\RcopyStructure.bat\""

; end