Windows Registry Editor Version 5.00

;Shutdown in x seconds

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\shutdown]
@="Shutdown in x seconds"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-29"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\shutdown\command]
@="\"C:\\Program Files\\RCWM\\Shutdown.bat\""

; end