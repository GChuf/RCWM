Windows Registry Editor Version 5.00

;Reboot in x seconds

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\reboot]
@="Reboot in x seconds"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-30"

[HKEY_LOCAL_MACHINE\SOFTWARE\Classes\Directory\Background\shell\reboot\command]
@="\"C:\\Program Files\\RCWM\\Reboot.bat\""

; end