Windows Registry Editor Version 5.00

;robocopy

[HKEY_CLASSES_ROOT\Directory\shell\rcopy]
@="RoboCopy Directory"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-6"

[HKEY_CLASSES_ROOT\Directory\shell\rcopy\command]
@="reg add \"HKCU\\RCWM\\rcopy\" /v gggggggggg"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rpaste]
@="RoboPaste Directory"
"Icon"="rcwmimg.dll,-6"

[HKEY_CLASSES_ROOT\Directory\Background\shell\rpaste\command]
@="cmd /c powershell Set-ExecutionPolicy Bypass -Force -Scope Process; C:\\Program Files (x86)\\RCWM\\rcp.ps1 rc s '%V'"
"IsolatedCommand"="cmd /c powershell Set-ExecutionPolicy Bypass -Force -Scope Process; C:\\Program Files (x86)\\RCWM\\rcp.ps1 rc s '%V'"

; end