Windows Registry Editor Version 5.00

;move dir

[HKEY_CLASSES_ROOT\Directory\shell\mvdir]
@="Move Directory"
"NoWorkingDirectory"=""
"Icon"="rcwmimg.dll,-3"

[HKEY_CLASSES_ROOT\Directory\shell\mvdir\command]
@="C:\\Program Files (x86)\\RCWM\\rcwm-single.exe rmove %V"

"IsolatedCommand"="C:\\Program Files (x86)\\RCWM\\rcwm-single.exe rmove %V"


[HKEY_CLASSES_ROOT\Directory\Background\shell\mvdir]
@="Move Directory Here"
"Icon"="rcwmimg.dll,-4"

[HKEY_CLASSES_ROOT\Directory\Background\shell\mvdir\command]
@="cmd /c powershell Set-ExecutionPolicy Bypass -Force -Scope Process; C:\\Program Files (x86)\\RCWM\\rcp.ps1 mv s '%V'"
"IsolatedCommand"="cmd /c powershell Set-ExecutionPolicy Bypass -Force -Scope Process; C:\\Program Files (x86)\\RCWM\\rcp.ps1 mv s '%V'"

; end